# POC ext-proc Plugin Environment Configuration

# Project
PROJECT_NAME=traefik-extproc-poc
COMPOSE_PROJECT_NAME=poc-ext-proc-plugin

# Traefik Configuration
TRAEFIK_LOG_LEVEL=DEBUG
TRAEFIK_API_INSECURE=true
TRAEFIK_API_DASHBOARD=true

# ext-proc Server Configuration  
EXTPROC_GRPC_PORT=9001
EXTPROC_LOG_LEVEL=DEBUG
EXTPROC_TIMEOUT=5s

# Development Configuration
DEV_MODE=true
HOT_RELOAD=true

# Network Configuration
NETWORK_SUBNET=172.20.0.0/16

# Ports
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=8443
TRAEFIK_API_PORT=8080
EXTPROC_PORT=9001

# Test Configuration
TEST_HOST=whoami.localhost
STRESS_TEST_DURATION=30s
STRESS_TEST_CONNECTIONS=100
